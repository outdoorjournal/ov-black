# Supabase project — public keys only. Service role key lives in Secrets
# Manager and is consumed by apps/api, never by the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# FastAPI base URL. In dev, point at http://localhost:8000. In staging this is
# the ALB DNS provisioned by infra/cdk (T08).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
