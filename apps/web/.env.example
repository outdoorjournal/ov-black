# Local-dev public config for apps/web. These NEXT_PUBLIC_* names are read as a
# fallback by lib/env.ts and work with `next dev`. In staging/prod the SAME values
# are injected at RUNTIME as OVB_* by the ECS task (see infra/cdk), so the built
# image carries no env and nothing here is baked into the production bundle.
#
# All values are browser-public. The Supabase service-role key lives in Secrets
# Manager and is consumed by apps/api, never by the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# FastAPI base URL. In dev, point at http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Mapbox public token (pk.*) for the itinerary map. Optional — the map degrades
# gracefully when unset.
NEXT_PUBLIC_MAPBOX_API_KEY=
